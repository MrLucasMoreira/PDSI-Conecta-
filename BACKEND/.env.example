# Banco de dados
MONGODB_URI=mongodb://127.0.0.1:27017/conecta
PORT=3000

# JWT
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria

# Administrador criado automaticamente se ainda não existir no banco
ROOT_USER_NAME=Administrador do Sistema
ROOT_USER_EMAIL=admin@admin.com
ROOT_USER_PASSWORD=troque-por-uma-senha-forte

# Recuperação de conta por e-mail (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=seu-email@gmail.com
MAIL_PASS=sua-senha-de-aplicativo
MAIL_FROM=Conecta+ <seu-email@gmail.com>
APP_RESET_URL=http://localhost:8081/redefinir-senha

# Para criar o banco, instale o MongoDB Community Server:
# https://www.mongodb.com/try/download/community
